# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------------

# Public: your Supabase project URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public: the anon / publishable key. Safe to expose. RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY: the service_role / secret key. Bypasses RLS. Never expose to
# the browser. Only used from server code (see lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public: the canonical URL of this deployment. Used to build magic-link
# emailRedirectTo when the request Origin header isn't available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
